{
  "expo": {
    "name": "Tarot",
    "slug": "oraculos-tarot",
    "owner": "betianare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D9B94A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.oraculos.tarot"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#260E16"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#260E16"
        }
      ],
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Celtica-Bold.ttf"
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5829308591228932~5466272602"
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "e89cbcda-8d37-4b90-8cfe-b63987b13108"
      }
    }
  }
}
